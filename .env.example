# Doubt Box Environment Configuration

# Django Settings
SECRET_KEY=your-production-secret-key-change-this-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Leave blank to default to local SQLite, or configure PostgreSQL)
# DATABASE_URL=postgresql://doubtbox_user:doubtbox_password@localhost:5432/doubtbox_db

# Redis Channel Layer (Optional for local dev - defaults to InMemoryChannelLayer)
# Set in production for multi-worker WebSockets
# REDIS_URL=redis://127.0.0.1:6379/1

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Environment Variables (for Vite)
# VITE_API_URL=http://127.0.0.1:8000
# VITE_WS_URL=ws://127.0.0.1:8000
